{
	"$schema": "https://schema.tauri.app/config/2",
	"build": {
		"beforeBuildCommand": "deno task build",
		"beforeDevCommand": "deno task dev",
		"frontendDist": "../build",
		"devUrl": "http://localhost:5173"
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"resources": { "target/plugins/": "plugins/" },
		"linux": {
			"deb": {
				"desktopTemplate": "bundle/linuxdeck.desktop",
				"files": {
					"/etc/udev/rules.d/40-streamdeck.rules": "bundle/40-streamdeck.rules",
					"/usr/share/metainfo/linuxdeck.metainfo.xml": "bundle/linuxdeck.metainfo.xml"
				}
			},
			"rpm": {
				"desktopTemplate": "bundle/linuxdeck.desktop",
				"files": {
					"/etc/udev/rules.d/40-streamdeck.rules": "bundle/40-streamdeck.rules",
					"/usr/share/metainfo/linuxdeck.metainfo.xml": "bundle/linuxdeck.metainfo.xml"
				}
			}
		},
		"publisher": "RealJoBoGamer",
		"shortDescription": "Linux-native Stream Deck host",
		"longDescription": "LinuxDeck is a fork of OpenDeck: a desktop application for using stream controller devices like the Elgato Stream Deck on Linux. It supports plugins made for the original Stream Deck SDK, with SteamOS / Steam Deck focused packaging and docs.",
		"category": "Productivity",
		"icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
		"macOS": {
			"exceptionDomain": "localhost",
			"signingIdentity": "-"
		}
	},
	"productName": "LinuxDeck",
	"mainBinaryName": "linuxdeck",
	"identifier": "linuxdeck",
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["linuxdeck", "opendeck", "openaction", "streamdeck"]
			}
		}
	},
	"app": {
		"windows": [
			{
				"title": "LinuxDeck",
				"fullscreen": false,
				"resizable": true,
				"width": 800,
				"height": 600,
				"minWidth": 800,
				"minHeight": 600,
				"center": true,
				"dragDropEnabled": false
			}
		],
		"security": {
			"csp": "default-src 'self' http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline'; img-src * data:; frame-src http://127.0.0.1:*; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https://openactionapi.github.io https://api.github.com https://raw.githubusercontent.com https://plugins.amankhanna.me;"
		},
		"withGlobalTauri": true
	}
}
